# Supabase — create a project at https://supabase.com, then Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sign-in buttons to show, once each provider is switched on in Supabase
# (Authentication → Sign In / Providers). Comma-separated: google,github
# Leave empty for email and password only.
NEXT_PUBLIC_AUTH_PROVIDERS=

# Public site URL. Used for metadata, OG tags, robots.txt and sitemap.xml.
# Locally this can be left unset (defaults to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app

# PostHog analytics. Leave unset to disable analytics entirely (local dev, forks).
# Key is from PostHog → Project Settings → Project API Key.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
